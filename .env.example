# === Aether OS Environment Variables ===
# Copy this file to .env and fill in values as needed.

# Runtime environment strategy
# - local: local development
# - preview: preview/test deployments
# - production: production runtime (requires PUTER_APP_ID when PUTER_JS_ENABLED=true)
APP_ENV=local

# Puter.js AI Integration
# Backend AI mode is Puter.js-only.
PUTER_JS_ENABLED=true

# Optional: Puter app identifier for project-scoped integrations.
PUTER_APP_ID=your-puter-app-id

# Frontend API base URL (optional for Vite local dev due to /api proxy)
# VITE_API_BASE_URL=
